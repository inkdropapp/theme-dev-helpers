{
  "name": "@inkdropapp/theme-dev-helpers",
  "version": "0.6.5",
  "description": "A helper module for creating themes for Inkdrop",
  "keywords": [
    "inkdrop",
    "markdown"
  ],
  "license": "MIT",
  "author": "Takuya Matsuyama<t@inkdrop.app>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkdropapp/theme-dev-helpers.git"
  },
  "bin": {
    "dev-server": "./bin/dev-server",
    "generate-palette": "./bin/generate-palette"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@inkdropapp/base-ui-theme": "^0.7.7",
    "@inkdropapp/css": "^0.9.12",
    "@vitejs/plugin-react": "^6.1.1",
    "commander": "^15.0.0",
    "puppeteer": "^25.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
